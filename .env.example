# The site is prerendered to static HTML and deployed without a database, a
# session store or a worker. There is no secret it needs in order to serve a
# page. These two are the whole list.

# Matomo site id for openplate.de. Analytics run without cookies, as the other
# SPRQVNTRS sites run them, so there is no consent banner to gate this behind.
MATOMO_SITE_ID=

# Read by scripts/translate-docs.ts only, never by the running site. The German
# documentation is translated at sync time, in CI, and committed; a request
# never calls a model.
OPENROUTER_API_KEY=
